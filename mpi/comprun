# Fortran and C files we want to run minus the .c and .f90
FS ?= f_allred
CS ?= c_allred


# MPIRUN command and the number to tasks
RUN  = mpirun
NP=4

# MPI compilers
PF90 = mpif90 
PCC  = mpicc 

# Instructions on how to build 
.SUFFIXES: .f90
.f90:
	$(PF90) $(F90FLAG) $< -o $@
	
.c:
	$(PCC) $(CFLAG) $< -o $@

# default thing to do 
# clean will delete old executables
# run with call the build commands
# and then run them 
# then we delete our executables again
doit: clean run clean

# our run lines
run: $(CS) $(FS)
	@echo $(MSG)
	echo running $(CS) 
	$(RUN) -n $(NP) ./$(CS)
	echo running $(FS) 
	$(RUN) -n $(NP) ./$(FS)

# our build lines
$(CS): $(CS).c
	$(PCC)  $(CS).c -o  $(CS)

$(FS): $(FS).f90
	$(PF90) $(FS).f90 -o $(FS)


# clean up
clean:
	rm -rf $(CS) $(FS) $(CS).out $(FS).out

# type our our sources
show: 
	echo +++++ $(CS).c
	cat $(CS).c
	echo
	echo +++++ $(FS).f90
	cat $(FS).f90



